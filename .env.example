# ============================================================================
# FRONTEND (Vite) - variables exposees au navigateur, prefixees VITE_
# ============================================================================

# URL de l'API backend si elle est hebergee SEPAREMENT du frontend
# (ex: frontend sur Vercel, backend sur Render). Laisser vide si le backend
# sert aussi le frontend (deploiement "single service", voir npm start).
VITE_API_URL=""

# ============================================================================
# BACKEND (Express + PostgreSQL) - server/*.ts
# ============================================================================

# Port d'ecoute de l'API en local (par defaut 4000)
PORT=4000

NODE_ENV=development

# Chaine de connexion PostgreSQL. En local avec Docker par exemple :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coulidev_portfolio"
DATABASE_URL="postgresql://user:password@localhost:5432/coulidev_portfolio"

# Secret utilise pour signer les tokens JWT de la session admin.
# Generez une valeur aleatoire forte, par ex : openssl rand -base64 32
JWT_SECRET="change-moi-avec-une-valeur-aleatoire-longue"
JWT_EXPIRES_IN="7d"

# Mot de passe de l'espace admin (bouton "Admin" dans le header/footer).
# En DEV, vous pouvez utiliser un mot de passe en clair :
ADMIN_PASSWORD="change-moi"
# En PRODUCTION, preferez un hash bcrypt (plus sur) et laissez ADMIN_PASSWORD vide :
# node -e "console.log(require('bcryptjs').hashSync('votre-mot-de-passe', 10))"
ADMIN_PASSWORD_HASH=""

# Origines autorisees pour les appels API cross-origin (CORS), separees par
# des virgules. Necessaire uniquement si frontend et backend sont sur des
# domaines differents. Exemple : "https://coulidev.fr,https://www.coulidev.fr"
CORS_ORIGINS=""

# --- Notification e-mail (optionnelle) pour le formulaire de contact -------
# Si non renseigne, les messages sont simplement stockes en base et visibles
# dans l'onglet admin > Messages.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL_TO=""
